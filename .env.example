ENV=dev
DATABASE_URL=sqlite:///./claimlens_local.db
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=10485760
CORS_ORIGINS=http://localhost:5173
MOCK_AI=true
MOCK_DOCS=true
RETENTION_HOURS=24
RATE_LIMIT_UPLOAD_PER_MIN=10
RATE_LIMIT_REVIEW_PER_MIN=60
RATE_LIMIT_ENABLED=true
TIMEOUT_EXTRACTING=30.0
TIMEOUT_INVESTIGATING=60.0
TIMEOUT_VERIFYING=60.0
MAX_RETRIES=2
LLM_PROVIDER=
GROQ_API_KEY=
GEMINI_API_KEY=
LLM_REPLAY=false
