server {
    listen 8080;
    root /usr/share/nginx/html;
    index index.html;
    client_max_body_size 25m;  # two PDFs of up to 10 MB each

    # The frontend calls relative /api URLs, as the Vite dev proxy does.
    location /api/ {
        proxy_pass ${BACKEND_URL};
        # Keep the backend's own Host header (hosted platforms route on it) and send SNI for https.
        proxy_ssl_server_name on;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        # Server-sent events: do not buffer, keep the connection open.
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
    }

    # Single-page app: unknown paths go to index.html.
    location / {
        try_files $uri $uri/ /index.html;
    }

    add_header X-Content-Type-Options nosniff;
    add_header Referrer-Policy no-referrer;
}
